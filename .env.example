# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored — never commit real secrets.

# Port for the local server (default 3000)
PORT=3000

# Key required when registering a TEACHER account.
# If unset, a random key is generated on first run and stored in data.json
# (and printed on the server console every time the server starts).
CURATE_ADMIN_KEY=change-me-teacher-signup-key

# Secret used to sign login tokens (HMAC). If unset, a random one is generated
# and stored in data.json. Changing it logs everybody out.
CURATE_SECRET=change-me-long-random-string

# Demo accounts on a fresh database: set to 0 to start with no accounts at all.
CURATE_SEED_DEMO=1
CURATE_DEMO_TEACHER_PW=change-me
CURATE_DEMO_STUDENT_PW=change-me
